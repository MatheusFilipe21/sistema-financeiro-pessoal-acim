{
  "name": "Dev Container (Java/Angular)",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Define variáveis de ambiente globais dentro do container
  "containerEnv": {
    "TZ": "America/Sao_Paulo"
  },

  "features": {
    // Habilita o Docker-outside-of-Docker (DooD):
    // 1. Monta o /var/run/docker.sock
    // 2. Instala o Docker CLI
    // 3. Adiciona o usuário 'vscode' ao grupo 'docker'
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      // Evita o erro de 'moby' no Debian 'trixie'
      // Isso instrui a feature a usar 'docker-ce-cli' em vez de 'moby-cli'
      "moby": false
    },
    // Node.js: Versão 22 LTS para Angular e ferramentas de análise
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    // Python: Para automação e testes E2E com Selenium/Cucumber
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },

  // Argumentos de execução para o container
  "runArgs": [
    // Permite que o container se comunique com o host local
    "--add-host=host.docker.internal:host-gateway",
    // Mapeamento de portas (Backend e Frontend)
    "-p",
    "8080:8080",
    "-p",
    "4200:4200"
  ],

  // Comando de Pós-Criação
  // 1. Garante permissão ao usuário vscode na pasta do projeto e instala o Angular CLI globalmente
  // 2. Adiciona o script de autocompletar do Angular ao bashrc
  // 3. Instala as dependências do frontend (npm ci) e do ambiente de testes E2E (pip)
  "postCreateCommand": "sudo chown -R vscode:vscode . && npm install -g @angular/cli@20 && echo 'source <(ng completion script)' >> /home/vscode/.bashrc && (cd frontend && npm ci) && pip install -r e2e/requirements.txt",

  // Customizações específicas do VS Code
  "customizations": {
    "vscode": {
      // Extensões que serão instaladas dentro do container
      "extensions": [
        "vscjava.vscode-java-pack", // Suporte completo ao ecossistema Java e Maven.
        "vmware.vscode-boot-dev-pack", // Ferramentas para desenvolvimento Spring Boot.
        "redhat.vscode-xml", // Suporte avançado e validação de arquivos XML.
        "angular.ng-template", // Inteligência de código e autocomplete para Angular.
        "dbaeumer.vscode-eslint", // Identificação e correção de problemas no TypeScript.
        "esbenp.prettier-vscode", // Formatador de código para manter o estilo visual.
        "ms-python.python", // Suporte completo à linguagem Python.
        "ms-python.vscode-pylance", // Servidor de linguagem de alta performance para Python.
        "littlefoxteam.vscode-python-test-adapter", // Interface para execução e gestão de testes Python.
        "CucumberOpen.cucumber-official", // Suporte ao BDD e integração com arquivos .feature.
        "SonarSource.sonarlint-vscode", // Analisador de qualidade de código em tempo real.
        "ryanluker.vscode-coverage-gutters", // Exibe a cobertura de testes diretamente no editor.
        "ms-azuretools.vscode-docker", // Gestão de imagens e containers Docker.
        "ms-azuretools.vscode-containers", // Extensão base para gestão de Dev Containers.
        "github.vscode-github-actions", // Integração e gestão de fluxos do GitHub Actions.
        "eamodio.gitlens", // Histórico avançado e visualização de autoria do Git.
        "ms-vscode.live-server" // Servidor local para recarregamento automático de páginas.
      ],
      // Customizações específicas do VS Code
      "settings": {
        // Trava o interpretador no Python instalado pela Feature para evitar conflitos com o sistema
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python3",
        "python.interpreterPath": "/usr/local/python/current/bin/python3",
        // Força o uso do interpretador global do container, ignorando detecção de ambientes virtuais (venv)
        "python-envs.defaultEnvManager": "ms-python.python:system",
        "python.terminal.activateEnvInSelectedTerminal": false,
        // Limita o Language Server do Java (JDT.LS) para não "sequestrar" a RAM do sistema
        "java.jdt.ls.vmargs": "-Xmx1G",
        // Otimiza o suporte ao Spring Boot: reduz heap e desativa otimizações pesadas de CPU (Tiered Compilation)
        "spring-boot.ls.java.vmargs": ["-Xmx256m", "-XX:TieredStopAtLevel=1"],
        // Limita o consumo do SonarLint em segundo plano, garantindo fluidez na edição de código
        "sonarlint.ls.vmargs": "-Xmx256m"
      }
    }
  },
  // Define o usuário padrão como não-root
  "remoteUser": "vscode"
}
